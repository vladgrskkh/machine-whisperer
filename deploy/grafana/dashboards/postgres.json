{
  "uid": "mw-postgres",
  "title": "PostgreSQL",
  "description": "PostgreSQL availability and machine_whisperer database statistics.",
  "tags": [
    "postgres"
  ],
  "editable": false,
  "schemaVersion": 40,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "type": "link",
      "title": "Telemetry pipeline",
      "url": "/grafana/d/mw-telemetry/telemetry-pipeline",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "API",
      "url": "/grafana/d/mw-go-services/go-services?var-job=api&var-instance=All",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Exporter scrape",
      "description": "Whether Prometheus can scrape the PostgreSQL exporter.",
      "gridPos": {
        "w": 12,
        "h": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mw-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                },
                "-1": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "up{job=\"postgres\"} or on() label_replace(vector(-1), \"instance\", \"No status series\", \"__name__\", \".*\")",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "PostgreSQL availability",
      "description": "Whether the exporter can connect to PostgreSQL.",
      "gridPos": {
        "w": 12,
        "h": 4,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mw-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                },
                "-1": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "pg_up{job=\"postgres\"} or on() label_replace(vector(-1), \"instance\", \"No status series\", \"__name__\", \".*\")",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Database connections",
      "description": "Backends currently connected to machine_whisperer, including idle sessions.",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mw-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: connections",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "pg_stat_database_numbackends{job=\"postgres\",datname=\"machine_whisperer\"}",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Transactions and rollbacks",
      "description": "Total completed transactions and rollbacks per second in machine_whisperer.",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mw-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: transactions/s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "rate(pg_stat_database_xact_commit{job=\"postgres\",datname=\"machine_whisperer\"}[$__rate_interval]) + rate(pg_stat_database_xact_rollback{job=\"postgres\",datname=\"machine_whisperer\"}[$__rate_interval])",
          "legendFormat": "{{instance}} total",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "rate(pg_stat_database_xact_rollback{job=\"postgres\",datname=\"machine_whisperer\"}[$__rate_interval])",
          "legendFormat": "{{instance}} rolled back",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Deadlocks",
      "description": "Deadlocks detected per second in machine_whisperer.",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mw-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: deadlocks/s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "rate(pg_stat_database_deadlocks{job=\"postgres\",datname=\"machine_whisperer\"}[$__rate_interval])",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Database size",
      "description": "On-disk size of machine_whisperer as reported by pg_database_size.",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mw-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "pg_database_size_bytes{job=\"postgres\",datname=\"machine_whisperer\"}",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Buffer cache hit ratio",
      "description": "Fraction of block reads served from the PostgreSQL buffer cache. Idle intervals leave a gap.",
      "gridPos": {
        "w": 24,
        "h": 8,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mw-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "(rate(pg_stat_database_blks_hit{job=\"postgres\",datname=\"machine_whisperer\"}[$__rate_interval]) / (rate(pg_stat_database_blks_hit{job=\"postgres\",datname=\"machine_whisperer\"}[$__rate_interval]) + rate(pg_stat_database_blks_read{job=\"postgres\",datname=\"machine_whisperer\"}[$__rate_interval]))) >= 0",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7
    }
  ]
}
