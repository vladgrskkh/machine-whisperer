{
  "uid": "mw-go-services",
  "title": "Go services",
  "description": "Go runtime, process, and HTTP workload metrics for API and Analytics.",
  "tags": [
    "go"
  ],
  "editable": false,
  "schemaVersion": 40,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Service",
        "type": "custom",
        "query": "api,analytics",
        "current": {
          "text": "api",
          "value": "api",
          "selected": true
        },
        "options": [
          {
            "text": "api",
            "value": "api",
            "selected": true
          },
          {
            "text": "analytics",
            "value": "analytics",
            "selected": false
          }
        ]
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mw-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"$job\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(up{job=\"$job\"}, instance)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ],
          "selected": true
        },
        "options": []
      }
    ]
  },
  "links": [
    {
      "type": "link",
      "title": "API",
      "url": "/grafana/d/mw-go-services/go-services?var-job=api&var-instance=All",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Analytics",
      "url": "/grafana/d/mw-go-services/go-services?var-job=analytics&var-instance=All",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Telemetry pipeline",
      "url": "/grafana/d/mw-telemetry/telemetry-pipeline",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Service scrape",
      "description": "Whether Prometheus can scrape each selected Go process.",
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mw-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                },
                "-1": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "up{job=\"$job\",instance=~\"${instance:regex}\"} or on() label_replace(vector(-1), \"instance\", \"No status series\", \"__name__\", \".*\")",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "HTTP requests by status class",
      "description": "Completed business requests across selected instances. Excludes /healthz.",
      "gridPos": {
        "w": 16,
        "h": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mw-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: req/s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (status_class) (rate(mw_http_requests_total{job=\"$job\",instance=~\"${instance:regex}\",route!=\"/healthz\"}[$__rate_interval]))",
          "legendFormat": "{{status_class}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2
    },
    {
      "type": "row",
      "title": "HTTP latency and concurrency",
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 8
      },
      "panels": [],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 latency by route",
      "description": "Histogram p95 by registered route across selected instances. Excludes /healthz. Idle windows appear as gaps.",
      "gridPos": {
        "w": 16,
        "h": 8,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mw-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(mw_http_request_duration_seconds_bucket{job=\"$job\",instance=~\"${instance:regex}\",route!=\"/healthz\"}[$__rate_interval]))) >= 0",
          "legendFormat": "{{route}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4
    },
    {
      "type": "table",
      "title": "Current HTTP p95 by route",
      "description": "Current p95 over the Prometheus rate interval.",
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 16,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mw-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "No observations"
                },
                "-2": {
                  "text": "Unknown"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(mw_http_request_duration_seconds_bucket{job=\"$job\",instance=~\"${instance:regex}\",route!=\"/healthz\"}[$__rate_interval]))) >= 0 or on() ((sum(up{job=\"$job\",instance=~\"${instance:regex}\"}) > 0) * 0 - 1) or on() vector(-2)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "route": "Route",
              "Value": "p95"
            }
          }
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "In-flight HTTP requests",
      "description": "Current business-listener requests by instance, including health checks.",
      "gridPos": {
        "w": 24,
        "h": 8,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mw-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: requests",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "mw_http_requests_in_flight{job=\"$job\",instance=~\"${instance:regex}\"}",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6
    },
    {
      "type": "row",
      "title": "Go runtime",
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 25
      },
      "panels": [],
