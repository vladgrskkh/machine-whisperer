{
  "uid": "mw-clickhouse",
  "title": "ClickHouse",
  "description": "Native Prometheus metrics for the ClickHouse server.",
  "tags": [
    "clickhouse"
  ],
  "editable": false,
  "schemaVersion": 40,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "type": "link",
      "title": "Telemetry pipeline",
      "url": "/grafana/d/mw-telemetry/telemetry-pipeline",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Analytics",
      "url": "/grafana/d/mw-go-services/go-services?var-job=analytics&var-instance=All",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Native endpoint scrape",
      "description": "Whether Prometheus can scrape the native endpoint through the private metrics proxy.",
      "gridPos": {
        "w": 24,
        "h": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mw-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                },
                "-1": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "up{job=\"clickhouse\"} or on() label_replace(vector(-1), \"instance\", \"No status series\", \"__name__\", \".*\")",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Queries",
      "description": "Query rate across the entire server. Selects and inserts are subsets of the total.",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mw-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: queries/s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "rate(ClickHouseProfileEvents_Query{job=\"clickhouse\"}[$__rate_interval])",
          "legendFormat": "{{instance}} all",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "rate(ClickHouseProfileEvents_SelectQuery{job=\"clickhouse\"}[$__rate_interval])",
          "legendFormat": "{{instance}} selects",
          "instant": false,
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "rate(ClickHouseProfileEvents_InsertQuery{job=\"clickhouse\"}[$__rate_interval])",
          "legendFormat": "{{instance}} inserts",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Failed queries",
      "description": "Failures per second across the server. Failed selects and inserts are subsets of the total.",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mw-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: queries/s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "rate(ClickHouseProfileEvents_FailedQuery{job=\"clickhouse\"}[$__rate_interval])",
          "legendFormat": "{{instance}} all",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "rate(ClickHouseProfileEvents_FailedSelectQuery{job=\"clickhouse\"}[$__rate_interval])",
          "legendFormat": "{{instance}} selects",
          "instant": false,
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "rate(ClickHouseProfileEvents_FailedInsertQuery{job=\"clickhouse\"}[$__rate_interval])",
          "legendFormat": "{{instance}} inserts",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Inserted rows",
      "description": "Rows inserted per second across all ClickHouse tables, as counted by the server.",
      "gridPos": {
