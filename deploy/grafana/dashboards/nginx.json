{
  "uid": "mw-nginx",
  "title": "Nginx",
  "description": "Public proxy traffic and connection state from Nginx OSS stub_status.",
  "tags": [
    "nginx"
  ],
  "editable": false,
  "schemaVersion": 40,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "type": "link",
      "title": "Telemetry pipeline",
      "url": "/grafana/d/mw-telemetry/telemetry-pipeline",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Exporter scrape",
      "description": "Whether Prometheus can scrape the Nginx exporter.",
      "gridPos": {
        "w": 12,
        "h": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mw-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                },
                "-1": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "up{job=\"nginx\"} or on() label_replace(vector(-1), \"instance\", \"No status series\", \"__name__\", \".*\")",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Nginx status",
      "description": "Whether the exporter can read the private Nginx stub_status endpoint.",
      "gridPos": {
        "w": 12,
        "h": 4,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mw-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                },
                "-1": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "nginx_up{job=\"nginx\"} or on() label_replace(vector(-1), \"instance\", \"No status series\", \"__name__\", \".*\")",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "HTTP requests",
      "description": "Aggregate requests handled by Nginx.",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mw-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: req/s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "rate(nginx_http_requests_total{job=\"nginx\"}[$__rate_interval])",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Connections",
      "description": "Current connections and their reading, writing, and waiting states.",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mw-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: connections",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "nginx_connections_active{job=\"nginx\"}",
          "legendFormat": "{{instance}} active",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "nginx_connections_reading{job=\"nginx\"}",
          "legendFormat": "{{instance}} reading",
          "instant": false,
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "nginx_connections_writing{job=\"nginx\"}",
          "legendFormat": "{{instance}} writing",
          "instant": false,
          "range": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "nginx_connections_waiting{job=\"nginx\"}",
          "legendFormat": "{{instance}} waiting",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4
    }
  ]
}
