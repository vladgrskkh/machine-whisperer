    {
      "type": "stat",
      "title": "Latest outbox snapshot age",
      "description": "Age of the newest snapshot from the latest scrape of each live API instance. Unknown if none returned a snapshot. Values of 90 seconds or more are stale.",
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mw-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "min((time() - mw_outbox_snapshot_timestamp_seconds{job=\"api\"}) and (mw_outbox_snapshot_timestamp_seconds{job=\"api\"} > 0) and on(job, instance) (up{job=\"api\"} == 1)) or on() vector(-1)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
