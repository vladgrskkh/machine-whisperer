    {
      "type": "stat",
      "title": "Pending rows",
      "description": "Undelivered rows, including leased and delayed rows. Requires a successful snapshot less than 90 seconds old.",
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mw-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: rows",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "max(mw_outbox_pending_events{job=\"api\"} and on(job, instance) ((mw_outbox_snapshot_timestamp_seconds{job=\"api\"} > 0) and ((time() - mw_outbox_snapshot_timestamp_seconds{job=\"api\"}) >= 0) and ((time() - mw_outbox_snapshot_timestamp_seconds{job=\"api\"}) < 90) and on(job, instance) (up{job=\"api\"} == 1))) or on() vector(-1)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 5
    },
