{
  "uid": "mw-telemetry",
  "title": "Telemetry pipeline",
  "description": "Follow device requests from API acceptance through outbox delivery and ClickHouse acknowledgement.",
  "tags": [
    "telemetry"
  ],
  "editable": false,
  "schemaVersion": 40,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "type": "link",
      "title": "Nginx",
      "url": "/grafana/d/mw-nginx/nginx",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "API",
      "url": "/grafana/d/mw-go-services/go-services?var-job=api&var-instance=All",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Analytics",
      "url": "/grafana/d/mw-go-services/go-services?var-job=analytics&var-instance=All",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "PostgreSQL",
      "url": "/grafana/d/mw-postgres/postgresql",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "ClickHouse",
      "url": "/grafana/d/mw-clickhouse/clickhouse",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Device ingest",
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Accepted device requests",
      "description": "Requests that committed a new device observation and accepted replays. Five-minute average rates.",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mw-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: req/s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(mw_telemetry_ingest_requests_total{job=\"api\",outcome=\"accepted_new\"}[5m]))",
          "legendFormat": "New observation",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(mw_telemetry_ingest_requests_total{job=\"api\",outcome=\"accepted_replay\"}[5m]))",
          "legendFormat": "Accepted replay",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Device ingest rejections and errors",
      "description": "Ingest use-case rejections and errors. Five-minute average rates. The Go services dashboard shows HTTP status classes, including requests rejected during authentication, authorization or decoding.",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mw-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: req/s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mw-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (outcome) (rate(mw_telemetry_ingest_requests_total{job=\"api\",outcome!~\"accepted_new|accepted_replay\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3
    },
    {
      "type": "row",
