map $http_upgrade $grafana_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name ${DOMAIN};
    access_log off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        try_files $uri =404;
    }
    location / {
        return 308 https://${DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_endpoint api:8443;
    proxy_ssl_server_name on;
    proxy_ssl_name api;
    proxy_ssl_trusted_certificate /run/secrets/internal_ca;
    proxy_ssl_verify on;

    proxy_set_header Host ${DOMAIN};
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host ${DOMAIN};
    proxy_set_header X-Forwarded-Port 443;

    location /v1/ {
        proxy_pass https://$api_endpoint;
    }
    location = /internal/v1/device-provisioning {
        allow ${MW_PROVISIONING_CIDR};
        deny all;
        proxy_pass https://$api_endpoint;
    }
    location = /grafana {
        return 308 https://${DOMAIN}/grafana/$is_args$args;
    }
    location ^~ /grafana/ {
        set $grafana_endpoint grafana:3000;
        proxy_pass http://$grafana_endpoint;
        proxy_http_version 1.1;
        proxy_set_header Host ${DOMAIN};
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host ${DOMAIN};
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $grafana_connection_upgrade;
    }
    location / {
        return 404;
    }
}
