map $http_upgrade $grafana_connection_upgrade {
    default upgrade;
    '' close;
}

otel_exporter {
    endpoint otel-collector:4317;
    interval 1s;
    batch_size 128;
    batch_count 4;
}
otel_service_name nginx;
otel_resource_attr service.namespace machine-whisperer;

split_clients "$otel_trace_id" $mw_trace_sampled {
    ${MW_TRACE_SAMPLE_RULES}
}
map $mw_trace_sampled $mw_trace_flags {
    on 01;
    default 00;
}

map $mw_trace_sampled $mw_sampled_trace_id {
    on $otel_trace_id;
    default "";
}
map $mw_log_trace_location $mw_log_trace_id {
    on $mw_sampled_trace_id;
    default "";
}

server {
    listen 80;
    server_name ${DOMAIN};
    access_log off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        try_files $uri =404;
    }
    location / {
        return 308 https://${DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log /var/log/nginx/access.log mw_failure if=$mw_log_failure;

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_endpoint api:8443;
    set $mw_log_trace_location off;
    proxy_ssl_server_name on;
    proxy_ssl_name api;
    proxy_ssl_trusted_certificate /run/secrets/internal_ca;
    proxy_ssl_verify on;

    proxy_set_header Host ${DOMAIN};
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host ${DOMAIN};
    proxy_set_header X-Forwarded-Port 443;
    # Replace every incoming value, including duplicates and unsampled context.
    proxy_set_header traceparent "00-$otel_trace_id-$otel_span_id-$mw_trace_flags";
    proxy_set_header tracestate "";
    proxy_set_header baggage "";

    location /v1/ {
        set $mw_log_trace_location on;
        otel_trace $mw_trace_sampled;
        otel_trace_context inject;
        otel_span_name "proxy /v1/";
        proxy_pass https://$api_endpoint;
    }
    location = /internal/v1/device-provisioning {
        allow ${MW_PROVISIONING_CIDR};
        deny all;
        set $mw_log_trace_location on;
        otel_trace $mw_trace_sampled;
        otel_trace_context inject;
        otel_span_name "proxy /internal/v1/device-provisioning";
        proxy_pass https://$api_endpoint;
    }
    location = /grafana {
        return 308 https://${DOMAIN}/grafana/$is_args$args;
    }
    location ^~ /grafana/ {
        set $grafana_endpoint grafana:3000;
        proxy_pass http://$grafana_endpoint;
        proxy_http_version 1.1;
        proxy_set_header Host ${DOMAIN};
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host ${DOMAIN};
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $grafana_connection_upgrade;
    }
    location = /jaeger {
        return 308 https://${DOMAIN}/jaeger/$is_args$args;
    }
    location ^~ /jaeger/ {
        auth_basic "Jaeger";
        auth_basic_user_file /run/secrets/jaeger_htpasswd;
        set $jaeger_endpoint jaeger:16686;
        # Jaeger detects the browser prefix and serves the upstream at its root.
        rewrite ^/jaeger(/.*)$ $1 break;
        proxy_pass http://$jaeger_endpoint;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
    }
    location / {
        return 404;
    }
}
